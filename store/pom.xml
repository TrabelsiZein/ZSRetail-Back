<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<!--
		The store application (package com.digithink.zsretail.store, main class StoreApplication), since
		code cleanup step 6.6: its WAR target/zsretail-store-<version>.war is deployed alone in its Tomcat under the
		context name zsretailws (docs/deploy-note.md). Its type file: application-store.properties. Its classes are
		also attached as zsretail-store-<version>-classes.jar, for the tests that need both applications.
	-->
	<parent>
		<groupId>com.digithink</groupId>
		<artifactId>zsretail-parent</artifactId>
		<version>3.1.1</version>
	</parent>
	<artifactId>zsretail-store</artifactId>
	<name>ZS Retail store</name>
	<packaging>war</packaging>

	<dependencies>
		<dependency>
			<groupId>com.digithink</groupId>
			<artifactId>zsretail-core</artifactId>
		</dependency>
		<!--
			The ERP connectors, all of them (connectors/pom.xml), at runtime only: in the WAR, but a class of the
			application that names one does not compile; a new connector does not change this pom
		-->
		<dependency>
			<groupId>com.digithink</groupId>
			<artifactId>zsretail-connectors</artifactId>
			<type>pom</type>
			<scope>runtime</scope>
		</dependency>

		<!--
			RFID step 1: the Hopeland reader SDK, the cleaned copy (without its own Commons Lang, junit and Swing code)
			from the file repository libs/maven; how it is made: libs/hopeland/README.md
		-->
		<dependency>
			<groupId>com.hopeland</groupId>
			<artifactId>rfid-reader-api</artifactId>
			<version>2.11-zs1</version>
		</dependency>

		<!-- The WAR's own: Tomcat is the server's, devtools for a run from the IDE -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-tomcat</artifactId>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-devtools</artifactId>
			<scope>runtime</scope>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-configuration-processor</artifactId>
			<optional>true</optional>
		</dependency>

		<!-- Code cleanup step 6.7: core's test helpers -->
		<dependency>
			<groupId>com.digithink</groupId>
			<artifactId>zsretail-core</artifactId>
			<version>${project.version}</version>
			<type>test-jar</type>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<!-- RFID step 1: the libraries of no public repository, kept in this repo (libs/hopeland/README.md) -->
	<repositories>
		<repository>
			<id>zsretail-libs</id>
			<url>file:${project.basedir}/../libs/maven</url>
		</repository>
	</repositories>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<mainClass>com.digithink.zsretail.store.StoreApplication</mainClass>
					<excludes>
						<exclude>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</exclude>
					</excludes>
				</configuration>
			</plugin>
			<!-- Code cleanup step 6.7: its test helpers, for the tests of the projects above it -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jar-plugin</artifactId>
				<executions>
					<execution>
						<goals>
							<goal>test-jar</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-war-plugin</artifactId>
				<configuration>
					<attachClasses>true</attachClasses>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>
