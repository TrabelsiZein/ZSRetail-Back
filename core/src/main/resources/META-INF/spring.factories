# Configuration step C1: the optional outside file of the installation, read before the configuration files; the
# installation type checked after them. Code cleanup step 8: erp.connector checked, the old ERP lines refused
org.springframework.boot.env.EnvironmentPostProcessor=com.digithink.zsretail.core.config.MachineFileEnvironmentPostProcessor,\
com.digithink.zsretail.core.config.InstallationTypeEnvironmentPostProcessor,\
com.digithink.zsretail.core.config.ErpConnectorEnvironmentPostProcessor
# Code cleanup step 5: erp-api asks the application which ERP connector is in effect
com.digithink.zsretail.erp.api.ErpConnectorResolver=com.digithink.zsretail.core.config.ErpConnectorInEffect
