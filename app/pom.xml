<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<!--
		Code cleanup step 6.1: the application as it was before the projects (one WAR, zsretailws.war, store or head office
		by its type). Its classes leave for the other projects one step at a time; it is gone at step 6.6.
	-->
	<parent>
		<groupId>com.digithink</groupId>
		<artifactId>zsretail-parent</artifactId>
		<version>2.2.2</version>
	</parent>
	<artifactId>zsretail-app</artifactId>
	<name>ZS Retail application</name>
	<packaging>war</packaging>

	<dependencies>
		<!-- Code cleanup step 6.4: what both applications use, with its libraries -->
		<dependency>
			<groupId>com.digithink</groupId>
			<artifactId>zsretail-core</artifactId>
		</dependency>
		<!--
			Code cleanup step 6.3: the connectors, at runtime only: in the WAR and for the tests, but a main class of the
			application that names one does not compile (the application asks ErpAbilities, never a connector)
		-->
		<dependency>
			<groupId>com.digithink</groupId>
			<artifactId>zsretail-connector-happyness</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>com.digithink</groupId>
			<artifactId>zsretail-connector-emtop</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!--
			Code cleanup step 6.5: the head office's classes for app's tests only (the round trips, the proofs), until they
			move at step 6.6; a main class of app that names one does not compile
		-->
		<dependency>
			<groupId>com.digithink</groupId>
			<artifactId>zsretail-headoffice</artifactId>
			<version>${project.version}</version>
			<classifier>classes</classifier>
			<scope>test</scope>
		</dependency>

		<!-- The WAR's own: Tomcat is the server's, devtools for a run from the IDE -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-tomcat</artifactId>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-devtools</artifactId>
			<scope>runtime</scope>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-configuration-processor</artifactId>
			<optional>true</optional>
		</dependency>
	</dependencies>
	<build>
		<resources>
			<resource>
				<directory>src/main/resources</directory>
				<filtering>true</filtering>
			</resource>
		</resources>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<excludes>
						<exclude>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</exclude>
					</excludes>
				</configuration>
			</plugin>
		</plugins>
		<finalName>zsretailws</finalName>
	</build>

	<!--
		Customer delivery WAR: strips selected classpath profile files so they are not on the server.
		Build: mvn clean package -Pcustomer-war
		Edit packagingExcludes below to match what each customer should not receive.
	-->
	<profiles>
		<profile>
			<id>customer-war</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-war-plugin</artifactId>
						<configuration>
							<packagingExcludes>
							WEB-INF/classes/application-dynamics-dev.properties,
								WEB-INF/classes/application-franchise-admin.properties,
								WEB-INF/classes/application-franchise-customer.properties,
								WEB-INF/classes/application-standalone-dev.properties								
							</packagingExcludes>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>

</project>

