# Configuration step C1: the optional outside file of the installation, read before the configuration files; the
# installation type checked after them. Code cleanup step 1: erp.connector translated into the two old enabled lines
org.springframework.boot.env.EnvironmentPostProcessor=com.digithink.zsretail.config.MachineFileEnvironmentPostProcessor,\
com.digithink.zsretail.config.InstallationTypeEnvironmentPostProcessor,\
com.digithink.zsretail.config.ErpConnectorEnvironmentPostProcessor
# Code cleanup step 5: erp-api asks the application which ERP connector is in effect
com.digithink.zsretail.erp.api.ErpConnectorResolver=com.digithink.zsretail.config.ErpConnectorInEffect
