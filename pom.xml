<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<!--
		Code cleanup step 6: the parent of every ZS Retail project, one version for all of them (the product version).
		Build and test from this folder (the reactor builds the projects in dependency order). The projects and the
		rules between them: docs/projects.md.
	-->
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.5.16</version>
		<relativePath /> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.digithink</groupId>
	<artifactId>zsretail-parent</artifactId>
	<version>4.0.0</version>
	<packaging>pom</packaging>
	<name>ZS Retail</name>

	<modules>
		<module>erp-api</module>
		<module>connectors</module>
		<module>core</module>
		<module>headoffice</module>
		<module>store</module>
		<module>network-tests</module>
	</modules>

	<properties>
		<!-- Boot's parent compiles with release=${java.version} -->
		<java.version>21</java.version>
		<!-- Above Boot's BOM (1.18.46 in 3.5.16), and new enough for the build on JDK 25 of step 2.6 -->
		<lombok.version>1.18.48</lombok.version>
		<!-- Boot's BOM pins 3.17.0, and commons-compress 1.28.0 (POI's) calls classes of 3.18: ExcelLibrariesTest -->
		<commons-lang3.version>3.18.0</commons-lang3.version>
	</properties>

	<build>
		<pluginManagement>
			<plugins>
				<!-- JDK 23 and later skip the annotation processors of the class path, so they are named, and asked for -->
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-compiler-plugin</artifactId>
					<configuration>
						<proc>full</proc>
						<annotationProcessorPaths>
							<path>
								<groupId>org.projectlombok</groupId>
								<artifactId>lombok</artifactId>
							</path>
							<path>
								<groupId>org.springframework.boot</groupId>
								<artifactId>spring-boot-configuration-processor</artifactId>
							</path>
						</annotationProcessorPaths>
					</configuration>
				</plugin>
			</plugins>
		</pluginManagement>
	</build>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>com.digithink</groupId>
				<artifactId>zsretail-erp-api</artifactId>
				<version>${project.version}</version>
			</dependency>
			<!-- The ERP connectors, all of them (connectors/pom.xml) -->
			<dependency>
				<groupId>com.digithink</groupId>
				<artifactId>zsretail-connectors</artifactId>
				<version>${project.version}</version>
				<type>pom</type>
			</dependency>
			<dependency>
				<groupId>com.digithink</groupId>
				<artifactId>zsretail-core</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.digithink</groupId>
				<artifactId>zsretail-headoffice</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.digithink</groupId>
				<artifactId>zsretail-store</artifactId>
				<version>${project.version}</version>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<!-- The test libraries of every project -->
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- In-memory database for the tests that run a JPQL query (version from Spring Boot); never in the WAR -->
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>
</project>
