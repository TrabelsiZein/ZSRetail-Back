<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<!--
		Code cleanup step 6: the parent of every ZS Retail project, one version for all of them (the product version).
		Build and test from this folder (the reactor builds the projects in dependency order). The projects and the
		rules between them: docs/roadmap/project-sorting.md.
	-->
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>2.3.9.RELEASE</version>
		<relativePath /> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.digithink</groupId>
	<artifactId>zsretail-parent</artifactId>
	<version>2.2.2</version>
	<packaging>pom</packaging>
	<name>ZS Retail</name>

	<modules>
		<module>erp-api</module>
		<module>connectors</module>
		<module>core</module>
		<module>headoffice</module>
		<module>store</module>
		<module>network-tests</module>
	</modules>

	<properties>
		<java.version>11</java.version>
		<maven-jar-plugin.version>3.1.1</maven-jar-plugin.version>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>com.digithink</groupId>
				<artifactId>zsretail-erp-api</artifactId>
				<version>${project.version}</version>
			</dependency>
			<!-- The ERP connectors, all of them (connectors/pom.xml) -->
			<dependency>
				<groupId>com.digithink</groupId>
				<artifactId>zsretail-connectors</artifactId>
				<version>${project.version}</version>
				<type>pom</type>
			</dependency>
			<dependency>
				<groupId>com.digithink</groupId>
				<artifactId>zsretail-core</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.digithink</groupId>
				<artifactId>zsretail-headoffice</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.digithink</groupId>
				<artifactId>zsretail-store</artifactId>
				<version>${project.version}</version>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<!-- The test libraries of every project -->
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- In-memory database for the tests that run a JPQL query (version from Spring Boot); never in the WAR -->
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<repositories>
		<repository>
			<id>spring-milestones</id>
			<name>Spring Milestones</name>
			<url>https://repo.spring.io/libs-milestone</url>
			<snapshots>
				<enabled>false</enabled>
			</snapshots>
		</repository>
	</repositories>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<testFailureIgnore>true</testFailureIgnore>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>
